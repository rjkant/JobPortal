// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model UserProfile {
  id              String   @id @default(cuid())
  fullName        String   @default("")
  email           String   @default("")
  phone           String   @default("")
  location        String   @default("")
  totalExperience Float    @default(0)
  currentRole     String   @default("")
  skills          String   @default("[]") // JSON array
  desiredRoles    String   @default("[]") // JSON array
  preferredLocs   String   @default("[]") // JSON array
  expectedCTC     String   @default("")
  noticePeriod    String   @default("")
  resumePath      String?
  linkedinUrl     String?
  summary         String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PlatformCredential {
  id             String    @id @default(cuid())
  platform       String    // naukri | instahire | shine | monster
  email          String
  password       String    // AES-256 encrypted
  sessionCookies String?   // JSON, refreshed automatically
  lastLogin      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model JobListing {
  id           String        @id @default(cuid())
  platform     String
  externalId   String        // platform-specific ID
  title        String
  company      String
  location     String
  salaryMin    Int?
  salaryMax    Int?
  experience   String?
  skills       String        @default("[]") // JSON array
  description  String
  applyUrl     String
  postedAt     DateTime?
  matchScore   Int           @default(0) // 0-100
  fetchedAt    DateTime      @default(now())
  applications Application[]

  @@unique([platform, externalId])
}

model Application {
  id             String     @id @default(cuid())
  jobId          String
  job            JobListing @relation(fields: [jobId], references: [id])
  status         String     @default("applied") // applied | viewed | shortlisted | interview | offer | rejected
  appliedAt      DateTime   @default(now())
  tailoredResume String?    // path to AI-tailored version
  coverLetter    String?    // AI-generated
  notes          String?
  updatedAt      DateTime   @updatedAt
}

model AutomationRun {
  id          String          @id @default(cuid())
  startedAt   DateTime        @default(now())
  completedAt DateTime?
  status      String          @default("running") // running | completed | failed
  platforms   String          @default("[]") // JSON array
  jobsFound   Int             @default(0)
  jobsApplied Int             @default(0)
  errors      String?         // JSON array
  logs        AutomationLog[]
}

model AutomationLog {
  id        String        @id @default(cuid())
  runId     String
  run       AutomationRun @relation(fields: [runId], references: [id])
  level     String        // info | warn | error
  message   String
  timestamp DateTime      @default(now())
}

model Settings {
  id             String  @id @default(cuid())
  key            String  @unique
  value          String
}
